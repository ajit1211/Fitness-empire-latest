# Environment variables for the deployed site.
#
# IMPORTANT: only create the entries you are actually giving a value to.
# A hosting dashboard stores an entry you leave blank as an empty string, not
# as "unset", so a blank box used to override the default and take the site
# down. The settings now treat blank as unset, but an empty entry is still
# clutter, so add a variable only when you have something to put in it.
#
# Nothing here is required. With none of it set the site runs in demo mode,
# with a banner on every page saying that nothing is saved.


# --- To make it a real site -------------------------------------------------

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The old key was published in the git history, so it cannot be reused.
# Without this a new key is generated per instance, which signs everyone out
# whenever a new one starts.
DJANGO_SECRET_KEY=

# Managed Postgres connection string. Neon, Supabase and Vercel Postgres all
# hand you one of these. Without it the site runs from a temporary copy of the
# bundled catalogue and every write is discarded.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require


# --- Optional ---------------------------------------------------------------
# Everything below has a working default. Skip any line you do not need.

# Your own domain, on top of the *.vercel.app hostnames that are added anyway.
# DJANGO_ALLOWED_HOSTS=fitnessempire.com,www.fitnessempire.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fitnessempire.com,https://www.fitnessempire.com

# Leave unset. Vercel sets VERCEL=1, which already turns DEBUG off.
# DJANGO_DEBUG=0

# Product images that ship with the repo are served by Django. Turn this off
# once MEDIA_ROOT points at object storage. Default: on.
# SERVE_MEDIA_FILES=0

# Forgot-password OTP email. With no password set the OTP is printed to the
# log instead of sent, which is fine for testing.
# The app password previously committed here must be revoked.
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=you@gmail.com
# EMAIL_HOST=smtp.gmail.com        (default)
# EMAIL_PORT=587                   (default)

# PayPal. PAYPAL_TEST=0 switches from the sandbox to live payments.
# PAYPAL_RECEIVER_EMAIL=you@business.example.com
# PAYPAL_TEST=1

# Rupee to USD rate used to convert the basket total before PayPal is charged.
# Must be a positive number. Default: 0.012
# INR_TO_USD_RATE=0.012

# Seconds of HSTS. Must be a whole number. Leave at the default of 0 until you
# are sure the domain stays on HTTPS, because browsers cache it.
# DJANGO_HSTS_SECONDS=0

# DJANGO_LOG_LEVEL=INFO            (default)
