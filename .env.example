# Copy the values you need into the Vercel dashboard under
# Settings -> Environment Variables. Do not commit a filled-in copy.

# --- Required in production -------------------------------------------------

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The old key was published in the git history, so it cannot be reused.
DJANGO_SECRET_KEY=

# Managed Postgres connection string. Neon, Supabase and Vercel Postgres all
# hand you one of these. Without it a deployed instance refuses to start,
# because the serverless filesystem cannot keep a SQLite file.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional ---------------------------------------------------------------

# Your own domain, on top of the *.vercel.app hostnames that are added anyway.
DJANGO_ALLOWED_HOSTS=fitnessempire.com,www.fitnessempire.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://fitnessempire.com,https://www.fitnessempire.com

# Leave unset. Vercel sets VERCEL=1, which already turns DEBUG off.
# DJANGO_DEBUG=0

# Run a throwaway demo with no database. Every sign-up, cart and order is lost
# when the instance recycles. Never set this on anything real.
# ALLOW_EPHEMERAL_DB=1

# Product images that ship with the repo are served by Django. Turn this off
# once MEDIA_ROOT points at object storage.
# SERVE_MEDIA_FILES=1

# Forgot-password OTP email. With no password set the OTP is printed to the
# Vercel log instead of sent, which is fine for testing.
# The app password previously committed here must be revoked.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# PayPal. PAYPAL_TEST=0 switches from the sandbox to live payments.
PAYPAL_RECEIVER_EMAIL=
PAYPAL_TEST=1

# Rupee to USD rate used to convert the basket total before PayPal is charged.
INR_TO_USD_RATE=0.012

# Set to a number of seconds to enable HSTS. Leave at 0 until you are sure the
# domain will stay on HTTPS, because browsers cache it.
DJANGO_HSTS_SECONDS=0

DJANGO_LOG_LEVEL=INFO
